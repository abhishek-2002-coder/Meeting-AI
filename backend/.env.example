# Application
APP_NAME=MeetingAI
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=meetingai_super_secret_jwt_key_32_characters_minimum_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=meetingai
POSTGRES_PASSWORD=meetingai_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meetingai_db
DATABASE_URL=postgresql+asyncpg://meetingai:meetingai_secret@localhost:5432/meetingai_db
DATABASE_URL_SYNC=postgresql://meetingai:meetingai_secret@localhost:5432/meetingai_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Pluggable AI Providers (options: "mock", "openai")
STT_PROVIDER=mock
LLM_PROVIDER=mock

# AI API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
